[Unit]
Description=MizorMart FastAPI App
After=network.target

[Service]
User=root
WorkingDirectory=/root/mizormart
Environment="PATH=/root/mizormart/venv/bin"
EnvironmentFile=/root/mizormart/.env
ExecStart=/root/mizormart/venv/bin/gunicorn \
    -w 4 \
    -k uvicorn.workers.UvicornWorker \
    -b 127.0.0.1:8000 \
    --timeout 120 \
    run:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
